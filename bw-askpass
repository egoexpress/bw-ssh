#!/usr/bin/env python3

from sh import rbw, ssh_keygen, ErrorReturnCode
from pathlib import Path
import getpass, io, os, re, sys

KEY_PATTERN = re.compile(
    r"^(?:Enter passphrase for|Bad passphrase, try again for)(?: key)? "
    r"'?(?P<path>.+?)'?: ?$"
)
RBW_ARGS = ["--folder", "ssh"]


def bw_get(key: Path):
    passphrase_cmd = rbw("get", *RBW_ARGS, key.name, _ok_code=[0, 1])
    if not passphrase_cmd:
        print(f"No passphrase entry found in Bitwarden for {key}", file=sys.stderr)
        sys.exit(1)
    # Remove new line character
    passphrase = str(passphrase_cmd)[:-1]
    return passphrase


def bw_exists(key: Path):
    # sh >= 2.0 returns a plain str instead of a RunningCommand unless
    # _return_cmd is set, so exit_code/stderr are only available this way.
    history_cmd = rbw(
        "history", *RBW_ARGS, key.name, _ok_code=[0, 1], _return_cmd=True
    )
    return history_cmd.exit_code == 0 or b"no entry found" not in history_cmd.stderr


def check_key(private_key: Path, passphrase: str):
    try:
        ssh_keygen(
            "-y", "-f", private_key, "-P", passphrase, _tty_out=False, _no_out=True
        )
        return True
    except ErrorReturnCode as ex:
        msg = ex.stderr.decode()
        print(f"Passphrase check failed: {msg}", file=sys.stderr)
        return False


def terminal_prompt(prompt: str):
    """Ask the user directly for prompts that are not key passphrases.

    SSH_ASKPASS_REQUIRE=prefer sends every prompt through this program,
    including host key confirmation and password prompts, so those must not
    be treated as vault lookups.
    """
    try:
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        print(prompt, end="", file=sys.stderr, flush=True)
        print(
            "bw-askpass: prompt needs a terminal, none is available",
            file=sys.stderr,
        )
        sys.exit(1)

    # A tty is not seekable, so plain open(..., "r+") would fail with
    # io.UnsupportedOperation; io.FileIO is happy with it.
    with io.TextIOWrapper(io.FileIO(fd, "r+")) as tty:
        if "yes/no" in prompt:
            tty.write(prompt)
            tty.flush()
            answer = tty.readline().strip()
            if not answer:
                sys.exit(1)
            return answer

    # Hide the input for passwords and keyboard-interactive prompts.
    try:
        return getpass.getpass(prompt)
    except EOFError:
        sys.exit(1)


def askpass():
    prompt = sys.argv[1] if len(sys.argv) > 1 else ""
    match = KEY_PATTERN.search(prompt)
    if not match:
        print(terminal_prompt(prompt), flush=True)
        return

    key = Path(match.group("path"))
    print(f"Reading passphrase from Bitwarden vault for {key}", file=sys.stderr)

    passphrase = bw_get(key)
    # We need to check the passphrase ourself,
    # otherwise, ssh-add will call us indefinitely.
    if not check_key(key, passphrase):
        sys.exit(1)
    print(passphrase, end="", flush=True)


def keygen():
    try:
        key = Path(sys.argv[sys.argv.index("-f") + 1])
    except:
        print("Key filename must be provided with -f", file=sys.stderr)
        sys.exit(1)
    if key.exists():
        print("Key already exists", file=sys.stderr)
        sys.exit(1)

    # Check if it exists
    if bw_exists(key):
        print("Passphrase entry already exists in your vault", file=sys.stderr)
        sys.exit(1)

    # Add passphrase in bitwarden first
    generate_command = rbw("generate", *RBW_ARGS, "20", key.name)
    passphrase = str(generate_command)[:-1]
    try:
        ssh_keygen(*sys.argv[1:], "-N", passphrase, _fg=True)
    except:
        sys.exit(1)


if __name__ == "__main__":
    mode = Path(sys.argv[0]).name
    if "askpass" in mode:
        askpass()
    elif "keygen" in mode:
        keygen()
