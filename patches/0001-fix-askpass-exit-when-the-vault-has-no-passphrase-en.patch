From 36f3d06520701bd2616abbada78e49492aca876c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bj=C3=B6rn=20Stierand?= <bjoern-github@innovention.de>
Date: Wed, 18 Nov 2026 09:50:34 +0100
Subject: [PATCH 1/4] fix(askpass): exit when the vault has no passphrase entry

Without the guard, an empty rbw result was handed to ssh (empty
passphrase) instead of a clear error.
---
 bw-askpass | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/bw-askpass b/bw-askpass
index b866af9..13cb8db 100755
--- a/bw-askpass
+++ b/bw-askpass
@@ -10,6 +10,9 @@ RBW_ARGS = ["--folder", "ssh"]
 
 def bw_get(key: Path):
     passphrase_cmd = rbw("get", *RBW_ARGS, key.name, _ok_code=[0, 1])
+    if not passphrase_cmd:
+        print(f"No passphrase entry found in Bitwarden for {key}", file=sys.stderr)
+        sys.exit(1)
     # Remove new line character
     passphrase = str(passphrase_cmd)[:-1]
     return passphrase
-- 
